[Unit]
Description=Check once a week for a new stable Hermes release

[Timer]
# Weekly, the owner's choice (2026-11-17): Mondays at 06:00 UTC, 11:00 for
# the owner (+05). Persistent: a run missed while entry was down happens at
# the next boot.
OnCalendar=Mon *-*-* 06:00:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
