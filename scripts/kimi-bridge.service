[Unit]
Description=kimi-code HTTP bridge for vpn-bot
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
EnvironmentFile=/etc/kimi-bridge.env
ExecStart=/usr/bin/python3 /usr/local/bin/kimi_bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
