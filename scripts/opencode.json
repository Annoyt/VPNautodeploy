{
  "$schema": "https://opencode.ai/config.json",
  "model": "moonshotai/kimi-k2",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf /": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "docker compose down*": "deny",
      "docker-compose down*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "cat */.env": "deny",
      "cat *.env": "deny",
      "printenv*": "deny"
    }
  },
  "instructions": ["AGENTS.md"]
}
