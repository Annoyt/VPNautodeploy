# VPN Bot Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# =============================================================================
# REQUIRED - Bot will fail to start if not set
# =============================================================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Chat ID (get from @userinfobot)
SUPER_ADMIN_ID=your_admin_chat_id

# Entry Node IP (public IP of your Entry Node server)
ENTRY_NODE_IP=your_entry_node_ip

# Reality Public Key (from 3X-UI panel: Xray Config -> Reality Settings)
REALITY_PUBLIC_KEY=your_reality_public_key

# =============================================================================
# OPTIONAL - Bot will use defaults if not set
# =============================================================================

# Mode: "GROUP" (with forum topics) or "PM_ONLY" (admin PM only)
# Default: GROUP
MODE=GROUP

# Forum Group ID (required if MODE=GROUP)
# Get from @getidsbot or check https://api.telegram.org/bot<TOKEN>/getUpdates
FORUM_GROUP_ID=your_forum_group_id

# Forum Topic IDs (for grouping messages)
# TOPIC_STATS=18
# TOPIC_REQUESTS=15
# TOPIC_DEMO=19
# TOPIC_REJECTED=20
# TOPIC_USERS=19
# TOPIC_SUPPORT=17
# TOPIC_PAYMENTS=16
# TOPIC_SOLVED=37

# Database paths
# DB_PATH=/etc/cascade-vpn/bot.db
# XUI_DB_PATH=/opt/3x-ui/db/x-ui.db

# 3X-UI Panel API
# XUI_PORT=2053
# XUI_API_URL=http://127.0.0.1:2053

# VPN Settings
# SNI_VALUE=www.microsoft.com
# SID_VALUE=

# Demo limits
# DEMO_TRAFFIC_GB=5
# DEMO_DAYS=7

# Web App URL (for inline keyboard buttons)
# WEBAPP_URL=https://your-domain.com/

# OpenCode AI agent — host-side `opencode serve` for /ai commands.
# OPENCODE_URL=http://host.docker.internal:4096
# OPENCODE_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your_basic_auth_password
# OPENCODE_DEFAULT_MODEL=moonshotai/kimi-k2   # provider/model form
# OPENCODE_AGENT_PLAN=plan                     # built-in deep-think agent
# AI_DEFAULT_MODE=fast    # "fast" (default) or "plan" (/ai_plan command)
# AGENT_NODE_TYPE=control # control | entry (where opencode serve runs)
# TOPIC_AI=0              # Forum topic ID for free-text AI chat (0=disabled)

# Xray reload sidecar — host-side service that ships SIGUSR1 into the
# 3x-ui container after every SQLite write so newly issued VLESS keys
# work immediately (instead of "sometimes the key is broken"). See
# scripts/xray_reload.py + systemd/xray-reload.service. Token shared
# with /etc/xray-reload.env on the host.
# XRAY_RELOAD_URL=http://host.docker.internal:7079
# XRAY_RELOAD_TOKEN=your_shared_secret

# =============================================================================
# SECURITY WARNING
# =============================================================================
# Never commit this file with real values to git!
# Keep your BOT_TOKEN and REALITY_PUBLIC_KEY secret.
